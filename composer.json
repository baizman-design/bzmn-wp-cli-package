{
    "name": "baizman-design/bzmn-wp-cli-package",
    "description": "A WP CLI package with commands for multiple clients.",
    "type": "wp-cli-package",
    "homepage": "https://github.com/baizman-design/bzmn-wp-cli-package",
    "license": "MIT",
    "authors": [
        {
            "name": "Saul Baizman",
            "email": "saul@baizmandesign.com",
            "homepage": "https://baizmandesign.com"
        }
    ],
    "require": {
        "php": ">=8.0"
    },
    "autoload": {
        "psr-4": {
            "baizman_design_cli\\": [
                "src/"
            ]
        },
        "files": [
            "bzmn.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "baizman_design_cli\\tests\\": [
                "src",
                "tests/"
            ]
        }
    },
    "support": {
        "issues": "https://github.com/baizman-design/bzmn-wp-cli-package/issues"
    },
    "scripts": {
        "sync-json": "php bin/sync-composer-json-commands.php",
        "local-dev": "open -a docker.app && sleep 10 && sh bin/local-dev.sh"
    },
    "extra": {
        "commands": [
            "bzmn",
            "bzmn backup",
            "bzmn clear-cloudflare-cache",
            "bzmn clear-sucuri-cache",
            "bzmn convert-imagery-to-webp",
            "bzmn correct-taxonomy-term-counts",
            "bzmn delete-woocommerce-transients",
            "bzmn disk-usage",
            "bzmn flush-rewrite-rules",
            "bzmn populate-post-meta",
            "bzmn print-custom-post-types",
            "bzmn print-wp-environment",
            "bzmn restore",
            "bzmn set-toolset-post-type-pagination",
            "bzmn toggle-debug",
            "bzmn toggle-debug-display"
        ],
        "readme": {
            "sections": [
                "installation",
                "docker",
                "automation",
                "using"
            ],
            "installation": {
                "body": "doc/installation.md"
            },
            "docker": {
                "body": "doc/docker.md"
            },
            "automation": {
                "body": "doc/github-actions.md"
            },
            "show_powered_by": false
        }
    }
}
